# Copy to ~/koe-ops/koe.env on the instance. Never commit the real file.
KOE_DOMAIN=koe.example.com
KOE_SECRET=replace-with-a-long-random-secret
API_KEY=replace-with-a-private-admin-key

# Optional deploy settings
KOE_REPO_URL=https://github.com/Azeru548/koe.git
KOE_BRANCH=main
KOE_REPO_DIR=/home/ec2-user/koe
