# Copy to ~/koe-ops/koe.env on the instance. Never commit the real file.
KOE_DOMAIN=koe.example.com
KOE_SECRET=replace-with-a-long-random-secret
API_KEY=replace-with-a-private-admin-key

# Optional deploy settings
KOE_REPO_URL=https://github.com/Azeru548/koe.git
KOE_BRANCH=main
KOE_REPO_DIR=/home/ec2-user/koe

# Where the issued-key/usage SQLite database lives. This MUST be on the mounted
# volume, or every container recreate wipes every key and counter. rebuild.sh
# defaults it to /data/koe.db; override here only if the volume moves.
KOE_DB_PATH=/data/koe.db

# ── Throughput ────────────────────────────────────────────────────────────
# These are forwarded to the container by rebuild.sh. Until now it hardcoded
# the global limit, which silently overrode this file — editing it did nothing.
#
# Elements of the budget on a 2 GiB host: each in-flight job runs
# KOE_PART_CONCURRENCY parts at once, and each edge part is its own ~100 MB
# process. 4 x 1 = 4 processes on top of Node, which is what fits.
KOE_GLOBAL_CONCURRENCY=4
KOE_PART_CONCURRENCY=1
# Per-engine in-flight ceiling: a sidecar engine cannot occupy every slot.
# Raise one only if you sized the host (and the sidecar's mem_limit) for it.
KOE_ENGINE_CONCURRENCY=kokoro=1,kitten=1

# Per-job word caps. Both are forwarded to the container, so this file is the
# place to change them; the defaults are what the app would use anyway.
# 2000 is the most edge-tts can finish inside the 300 s job deadline;
# kitten is ~3 words/s, so ~900 words is its ceiling for the same deadline.
KOE_MAX_JOB_WORDS=2000
KOE_ENGINE_MAX_WORDS=kitten=900

# Sidecar base URLs as seen from INSIDE the koe container (compose network).
# Empty sidecars are fine: that engine answers 503 and nothing else is affected.
KOKORO_BASE_URL=http://kokoro:8880
KITTEN_BASE_URL=http://kitten:8881

# Sidecar memory ceilings are docker-compose variables, not app variables, so
# compose only sees them from its own .env or the shell:
#   cd ~/koe && sudo docker compose --env-file ~/koe-ops/koe.env up -d
KOKORO_MEM_LIMIT=1g
KITTEN_MEM_LIMIT=512m

# Host directory mounted at /data. rebuild.sh takes the key database out of the
# container it is replacing and into here, so recreates stop losing keys.
KOE_DATA_DIR=/home/ec2-user/koe-data
